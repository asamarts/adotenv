# Public example configuration. No credentials are real.
# Source: netlify/explorers .env.EXAMPLE
# https://github.com/netlify/explorers/blob/673f722883841fa0078c1849ffd25a3f137c5d77/.env.EXAMPLE
NETLIFY_OAUTH_CLIENT_ID=<your-client-id>
NETLIFY_OAUTH_CLIENT_SECRET=<your-client-id>
NETLIFY_OAUTH_REDIRECT_URI=<your-url>/.netlify/functions/auth-callback
NEXT_PUBLIC_SANITY_GRAPHQL_URL=<your-sanity-graphql-url>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>
SLACK_WEBHOOK_URL=<your-slack-webhook-url>

# Source: anuraghazra/convoychat .env.EXAMPLE
# https://github.com/anuraghazra/convoychat/blob/8eedf6d67d4502ed9cc43ccfbcd25d222bf8e5d6/.env.EXAMPLE
DB_URL=mongodb://localhost:27017/convoychat
TEST_DB_URI=mongodb://localhost:27017/convoychat-test
SESSION_SECRECT=secretKeyForSessions
AUTH0_CLIENT_ID=auth0clientid
AUTH0_DOMAIN=username.auth0.com
AUTH0_CLIENT_SECRET=auth0clientsecret
CLOUDINARY_CLOUD_NAME=cloudinary_name
CLOUDINARY_API_KEY=cloudinaryapikey
CLOUDINARY_API_SECRET=cloudinaryapisecret
MEDIA_FOLDER=convoychat-media
NODE_ENV=development
MOCK_EMAIL=fakeuser@gmail.com

# Source: rodneylab/sveltekit-blog-mdx .env.EXAMPLE
# https://github.com/rodneylab/sveltekit-blog-mdx/blob/46c461ab6a0ce6ac45a6bc82f2795b078e45af08/.env.EXAMPLE
PUBLIC_CONTACT_EMAIL="ask@rodneylab.com"
PUBLIC_FACEBOOK_PAGE="rodneyLab"
PUBLIC_FACEBOOK_AUTHOR_PAGE="rodneyLab"
PUBLIC_GITHUB_PAGE="rodneylab"
PUBLIC_LINKEDIN_PROFILE="ask-rodney"
PUBLIC_TELEGRAM_USERNAME="askRodney"
PUBLIC_TIKTOK_USERNAME="@askRodney"
PUBLIC_TWITTER_USERNAME="askRodney"
PUBLIC_TWITTER_USER_ID="1234567890"
PUBLIC_WIRE_USERNAME="@rodneylab"
PUBLIC_DOMAIN="example.com"
PUBLIC_SITE_URL="https://example.com"
PUBLIC_SENTRY_ORG_ID="123456"
PUBLIC_SENTRY_PROJECT_ID="9876543"
PUBLIC_SENTRY_KEY="01234567891bcdef0123456789abcd"
